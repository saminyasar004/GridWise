# GridWise - Grid Energy Optimization Service
# Copy to .env and fill in real credentials.

# Server
HOST=0.0.0.0
PORT=3000

# LLM interpreter (any OpenAI-compatible endpoint, e.g. OpenAI, Gemini, Azure, Ollama, vLLM)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_CHAT_COMPLETIONS_PATH=/chat/completions
LLM_TIMEOUT_MS=9000
LLM_MAX_REPROMPTS=1
LLM_MAX_PROVIDER_RETRIES=1
LLM_TEMPERATURE=0

# Fallback guardrails (deterministic; used when the LLM is unavailable)
ENABLE_HEURISTIC_FALLBACK=true

# Caching
CACHE_ENABLED=true
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=128

# Request handling
REQUEST_TIMEOUT_MS=25000
BODY_LIMIT_MB=1

# Swagger
SWAGGER_ENABLED=true
