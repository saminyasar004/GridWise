# GridWise - Grid Energy Optimization Service
# Copy to .env and fill in real credentials.

# Server
GRIDWISE_HOST=0.0.0.0
GRIDWISE_PORT=3000

# Swagger /docs title and description
GRIDWISE_API_TITLE=GridWise Energy Optimizer API
GRIDWISE_API_DESCRIPTION=LLM-in-the-loop grid energy optimization API
GRIDWISE_SWAGGER_VERSION=1.0.0
GRIDWISE_SWAGGER_PATH=/docs

# LLM interpreter (any OpenAI-compatible endpoint, e.g. OpenAI, Azure, Ollama, vLLM)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2
OPENAI_JSON_MODE=false

# Fallback guardrails (deterministic)
GRIDWISE_FALLBACK_MODE=default

# Caching
GRIDWISE_CACHE_TTL_MS=300000
